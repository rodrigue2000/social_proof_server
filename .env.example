# Clé secrète FedaPay (dashboard FedaPay > Clés API)
FEDAPAY_SECRET_KEY=sk_sandbox_xxxxxxxxxxxxxxxxxxxx

# 'sandbox' pendant les tests, 'live' une fois prêt pour la production
FEDAPAY_ENV=sandbox

# Secret du endpoint webhook (dashboard FedaPay > Webhooks > ton endpoint > Click to reveal)
FEDAPAY_WEBHOOK_SECRET=wh_sandbox_xxxxxxxxxxxxxxxxxxxx

# URL vers laquelle FedaPay redirige l'utilisateur après paiement (peut être une simple page de remerciement)
FEDAPAY_CALLBACK_URL=https://socialproof.app/paiement-termine

# Contenu JSON complet de la clé de compte de service Firebase, sur UNE SEULE LIGNE
# (voir README.md pour savoir comment l'obtenir)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"sproof-a9d97",...}

# Port d'écoute (Render le fournit automatiquement, pas besoin de le définir sur Render)
PORT=3000
